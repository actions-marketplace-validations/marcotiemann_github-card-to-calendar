{
  "name": "github-card-to-calendar",
  "version": "1.0.0",
  "description": "GitHub Action to generate an iCal (.ics) calendar feed from GitHub Issues and Projects v2 cards across multiple repositories.",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "esbuild tests/verify.js --bundle --platform=node --target=node20 --outfile=dist/verify.cjs && node dist/verify.cjs"
  },
  "keywords": [
    "github-action",
    "ical",
    "google-calendar",
    "github-issues",
    "github-projects",
    "calendar",
    "productivity"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/github": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.24",
    "esbuild": "^0.20.2",
    "typescript": "^5.3.3"
  }
}
